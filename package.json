{
  "name": "@metamask/oxlint-config-root",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/oxlint-config.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "changelog:update": "yarn workspaces foreach --all --no-private --parallel --interlaced --verbose run changelog:update",
    "changelog:validate": "yarn workspaces foreach --all --no-private --parallel --interlaced --verbose run changelog:validate",
    "lint": "yarn lint:oxlint && yarn lint:misc --check && yarn lint:dependencies && yarn lint:config-validation",
    "lint:config-validation": "yarn workspaces foreach --all --no-private exec ../../scripts/validate-configs.sh",
    "lint:dependencies": "depcheck && yarn dedupe --check",
    "lint:dependencies:fix": "depcheck && yarn dedupe",
    "lint:fix": "yarn lint:oxlint --fix && yarn oxfmt --write && yarn lint:dependencies:fix && yarn lint:config-validation --write",
    "lint:misc": "oxfmt",
    "lint:oxlint": "oxlint",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.18.0",
    "@lavamoat/allow-scripts": "^3.0.4",
    "@metamask/auto-changelog": "^3.4.4",
    "@metamask/create-release-branch": "^4.1.3",
    "@metamask/eslint-config-nodejs": "workspace:^",
    "@metamask/eslint-config-typescript": "workspace:^",
    "@metamask/eslint-config-vitest": "workspace:^",
    "@metamask/oxlint-config": "workspace:^",
    "@metamask/utils": "^9.1.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.5.5",
    "depcheck": "^1.4.7",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsdoc": "^50.2.4",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-prettier": "^5.2.1",
    "oxlint": "^1.59.0",
    "prettier": "^3.3.3",
    "prettier-plugin-packagejson": "^2.5.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "^18.18 || >=20"
  },
  "packageManager": "yarn@4.5.0",
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "vite>esbuild": true
    }
  }
}
