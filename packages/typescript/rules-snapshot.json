{
  "default-param-last": "deny",
  "no-dupe-class-members": "deny",
  "no-shadow": "deny",
  "no-unused-expressions": "deny",
  "no-unused-vars": "deny",
  "no-use-before-define": "deny",
  "no-useless-constructor": "deny",
  "typescript/array-type": "deny",
  "typescript/consistent-type-assertions": "deny",
  "typescript/consistent-type-definitions": ["deny", ["type"]],
  "typescript/consistent-type-exports": "deny",
  "typescript/explicit-function-return-type": "deny",
  "typescript/no-duplicate-type-constituents": "allow",
  "typescript/no-explicit-any": "allow",
  "typescript/no-meaningless-void-operator": "deny",
  "typescript/no-namespace": [
    "deny",
    [
      {
        "allowDefinitionFiles": true
      }
    ]
  ],
  "typescript/no-non-null-assertion": "deny",
  "typescript/no-redundant-type-constituents": "allow",
  "typescript/no-unnecessary-boolean-literal-compare": "deny",
  "typescript/no-unnecessary-qualifier": "deny",
  "typescript/no-unnecessary-type-arguments": "allow",
  "typescript/no-unsafe-argument": "allow",
  "typescript/no-unsafe-assignment": "allow",
  "typescript/no-unsafe-call": "allow",
  "typescript/no-unsafe-enum-comparison": "allow",
  "typescript/no-unsafe-member-access": "allow",
  "typescript/no-unsafe-return": "allow",
  "typescript/parameter-properties": "deny",
  "typescript/prefer-enum-initializers": "deny",
  "typescript/prefer-for-of": "deny",
  "typescript/prefer-function-type": "deny",
  "typescript/prefer-includes": "deny",
  "typescript/prefer-nullish-coalescing": "deny",
  "typescript/prefer-optional-chain": "deny",
  "typescript/prefer-promise-reject-errors": [
    "deny",
    [
      {
        "allowThrowingUnknown": true
      }
    ]
  ],
  "typescript/prefer-readonly": "deny",
  "typescript/prefer-reduce-type-parameter": "deny",
  "typescript/prefer-string-starts-ends-with": "deny",
  "typescript/promise-function-async": "deny",
  "typescript/require-await": "allow",
  "typescript/restrict-template-expressions": [
    "deny",
    [
      {
        "allowBoolean": true,
        "allowNumber": true
      }
    ]
  ],
  "typescript/switch-exhaustiveness-check": [
    "deny",
    [
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ]
  ],
  "typescript/unified-signatures": "deny"
}
