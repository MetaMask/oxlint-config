{
  "accessor-pairs": "deny",
  "array-callback-return": "deny",
  "block-scoped-var": "deny",
  "constructor-super": "deny",
  "curly": ["deny", ["all"]],
  "default-case": "deny",
  "default-param-last": "deny",
  "eqeqeq": ["deny", ["smart"]],
  "for-direction": "deny",
  "getter-return": "warn",
  "grouped-accessor-pairs": "deny",
  "guard-for-in": "deny",
  "id-length": [
    "deny",
    [
      {
        "min": 2,
        "properties": "never",
        "exceptionPatterns": ["_", "a", "b", "i", "j", "k"]
      }
    ]
  ],
  "new-cap": [
    "deny",
    [
      {
        "newIsCap": true,
        "capIsNew": false
      }
    ]
  ],
  "no-alert": "deny",
  "no-array-constructor": "deny",
  "no-async-promise-executor": "deny",
  "no-bitwise": "deny",
  "no-caller": "deny",
  "no-class-assign": "deny",
  "no-compare-neg-zero": "deny",
  "no-cond-assign": "deny",
  "no-const-assign": "deny",
  "no-constant-binary-expression": "deny",
  "no-constant-condition": "deny",
  "no-constructor-return": "deny",
  "no-control-regex": "deny",
  "no-debugger": "deny",
  "no-delete-var": "deny",
  "no-div-regex": "deny",
  "no-dupe-class-members": "deny",
  "no-dupe-else-if": "deny",
  "no-dupe-keys": "deny",
  "no-duplicate-case": "deny",
  "no-else-return": "deny",
  "no-empty-character-class": "deny",
  "no-empty-function": "deny",
  "no-empty-pattern": "deny",
  "no-empty-static-block": "deny",
  "no-eq-null": "deny",
  "no-eval": "deny",
  "no-ex-assign": "deny",
  "no-extend-native": "deny",
  "no-extra-bind": "deny",
  "no-extra-boolean-cast": "deny",
  "no-extra-label": "deny",
  "no-func-assign": "deny",
  "no-global-assign": "deny",
  "no-implicit-coercion": "deny",
  "no-import-assign": "deny",
  "no-inner-declarations": ["deny", ["functions"]],
  "no-invalid-regexp": "deny",
  "no-irregular-whitespace": "deny",
  "no-iterator": "deny",
  "no-labels": [
    "deny",
    [
      {
        "allowLoop": false,
        "allowSwitch": false
      }
    ]
  ],
  "no-lone-blocks": "deny",
  "no-lonely-if": "deny",
  "no-loop-func": "deny",
  "no-loss-of-precision": "deny",
  "no-misleading-character-class": "deny",
  "no-multi-assign": "deny",
  "no-multi-str": "deny",
  "no-negated-condition": "deny",
  "no-nested-ternary": "deny",
  "no-new": "deny",
  "no-new-func": "deny",
  "no-new-native-nonconstructor": "deny",
  "no-new-wrappers": "deny",
  "no-nonoctal-decimal-escape": "deny",
  "no-obj-calls": "deny",
  "no-param-reassign": "deny",
  "no-plusplus": [
    "deny",
    [
      {
        "allowForLoopAfterthoughts": true
      }
    ]
  ],
  "no-proto": "deny",
  "no-return-assign": ["deny", ["except-parens"]],
  "no-script-url": "deny",
  "no-self-assign": "deny",
  "no-self-compare": "deny",
  "no-setter-return": "deny",
  "no-shadow": "deny",
  "no-shadow-restricted-names": "deny",
  "no-sparse-arrays": "deny",
  "no-template-curly-in-string": "deny",
  "no-this-before-super": "deny",
  "no-throw-literal": "deny",
  "no-unassigned-vars": "deny",
  "no-unmodified-loop-condition": "deny",
  "no-unneeded-ternary": [
    "deny",
    [
      {
        "defaultAssignment": false
      }
    ]
  ],
  "no-unreachable": "warn",
  "no-unsafe-finally": "deny",
  "no-unsafe-negation": "deny",
  "no-unsafe-optional-chaining": "deny",
  "no-unused-expressions": [
    "deny",
    [
      {
        "allowShortCircuit": true,
        "allowTernary": true
      }
    ]
  ],
  "no-unused-labels": "deny",
  "no-unused-private-class-members": "warn",
  "no-unused-vars": [
    "deny",
    [
      {
        "vars": "all",
        "args": "all",
        "argsIgnorePattern": "[_]+",
        "ignoreRestSiblings": true
      }
    ]
  ],
  "no-use-before-define": "deny",
  "no-useless-backreference": "deny",
  "no-useless-call": "deny",
  "no-useless-catch": "deny",
  "no-useless-computed-key": "deny",
  "no-useless-concat": "deny",
  "no-useless-constructor": "deny",
  "no-useless-escape": "deny",
  "no-useless-rename": "deny",
  "no-useless-return": "deny",
  "no-var": "deny",
  "no-void": "deny",
  "no-with": "deny",
  "operator-assignment": "deny",
  "prefer-const": "deny",
  "prefer-destructuring": [
    "deny",
    [
      {
        "VariableDeclarator": {
          "array": false,
          "object": true
        },
        "AssignmentExpression": {
          "array": false,
          "object": false
        }
      },
      {
        "enforceForRenamedProperties": false
      }
    ]
  ],
  "prefer-numeric-literals": "deny",
  "prefer-promise-reject-errors": "deny",
  "prefer-rest-params": "deny",
  "prefer-spread": "deny",
  "prefer-template": "deny",
  "radix": "deny",
  "require-yield": "deny",
  "symbol-description": "deny",
  "use-isnan": "deny",
  "valid-typeof": "deny",
  "yoda": ["deny", ["never"]],
  "import/consistent-type-specifier-style": ["deny", ["prefer-top-level"]],
  "import/default": "warn",
  "import/extensions": [
    "deny",
    [
      "ignorePackages",
      {
        "json": "always"
      }
    ]
  ],
  "import/first": "deny",
  "import/namespace": "warn",
  "import/no-absolute-path": "deny",
  "import/no-amd": "deny",
  "import/no-anonymous-default-export": "deny",
  "import/no-duplicates": "allow",
  "import/no-dynamic-require": "deny",
  "import/no-mutable-exports": "deny",
  "import/no-named-as-default": "deny",
  "import/no-named-as-default-member": "deny",
  "import/no-named-default": "deny",
  "import/no-nodejs-modules": "allow",
  "import/no-self-import": "deny",
  "import/no-unassigned-import": "deny",
  "import/no-webpack-loader-syntax": "deny",
  "import/unambiguous": "deny",
  "jsdoc/check-access": "deny",
  "jsdoc/check-property-names": "deny",
  "jsdoc/check-tag-names": "deny",
  "jsdoc/empty-tags": "deny",
  "jsdoc/implements-on-classes": "deny",
  "jsdoc/no-defaults": "deny",
  "jsdoc/require-param": "deny",
  "jsdoc/require-param-description": "deny",
  "jsdoc/require-param-name": "deny",
  "jsdoc/require-param-type": "allow",
  "jsdoc/require-property": "deny",
  "jsdoc/require-property-description": "deny",
  "jsdoc/require-property-name": "deny",
  "jsdoc/require-property-type": "allow",
  "jsdoc/require-returns": "deny",
  "jsdoc/require-returns-description": "deny",
  "jsdoc/require-returns-type": "allow",
  "jsdoc/require-yields": "deny",
  "node/callback-return": "deny",
  "node/exports-style": "deny",
  "node/global-require": "deny",
  "node/handle-callback-err": ["deny", ["^(err|error)$"]],
  "node/no-mixed-requires": "deny",
  "node/no-new-require": "deny",
  "node/no-path-concat": "deny",
  "node/no-process-env": "deny",
  "node/no-sync": "deny",
  "promise/catch-or-return": [
    "deny",
    [
      {
        "allowFinally": true
      }
    ]
  ],
  "promise/no-callback-in-promise": "deny",
  "promise/no-nesting": "deny",
  "promise/no-new-statics": "warn",
  "promise/no-promise-in-callback": "deny",
  "promise/no-return-in-finally": "deny",
  "promise/param-names": [
    "deny",
    [
      {
        "resolvePattern": "^_?resolve",
        "rejectPattern": "^_?reject"
      }
    ]
  ],
  "promise/valid-params": "allow",
  "typescript/array-type": "deny",
  "typescript/await-thenable": "warn",
  "typescript/consistent-type-assertions": "deny",
  "typescript/consistent-type-definitions": ["deny", ["type"]],
  "typescript/consistent-type-exports": "deny",
  "typescript/explicit-function-return-type": "deny",
  "typescript/no-array-delete": "warn",
  "typescript/no-base-to-string": "warn",
  "typescript/no-duplicate-enum-values": "warn",
  "typescript/no-duplicate-type-constituents": "allow",
  "typescript/no-explicit-any": "allow",
  "typescript/no-extra-non-null-assertion": "warn",
  "typescript/no-floating-promises": "warn",
  "typescript/no-for-in-array": "warn",
  "typescript/no-implied-eval": "warn",
  "typescript/no-meaningless-void-operator": "deny",
  "typescript/no-misused-new": "warn",
  "typescript/no-misused-spread": "warn",
  "typescript/no-namespace": [
    "deny",
    [
      {
        "allowDefinitionFiles": true
      }
    ]
  ],
  "typescript/no-non-null-asserted-optional-chain": "warn",
  "typescript/no-non-null-assertion": "deny",
  "typescript/no-redundant-type-constituents": "allow",
  "typescript/no-this-alias": "warn",
  "typescript/no-unnecessary-boolean-literal-compare": "deny",
  "typescript/no-unnecessary-parameter-property-assignment": "warn",
  "typescript/no-unnecessary-qualifier": "deny",
  "typescript/no-unnecessary-type-arguments": "allow",
  "typescript/no-unsafe-argument": "allow",
  "typescript/no-unsafe-assignment": "allow",
  "typescript/no-unsafe-call": "allow",
  "typescript/no-unsafe-declaration-merging": "warn",
  "typescript/no-unsafe-enum-comparison": "allow",
  "typescript/no-unsafe-member-access": "allow",
  "typescript/no-unsafe-return": "allow",
  "typescript/no-unsafe-unary-minus": "warn",
  "typescript/no-useless-default-assignment": "warn",
  "typescript/no-useless-empty-export": "warn",
  "typescript/no-wrapper-object-types": "warn",
  "typescript/parameter-properties": "deny",
  "typescript/prefer-as-const": "warn",
  "typescript/prefer-enum-initializers": "deny",
  "typescript/prefer-for-of": "deny",
  "typescript/prefer-function-type": "deny",
  "typescript/prefer-includes": "deny",
  "typescript/prefer-namespace-keyword": "warn",
  "typescript/prefer-nullish-coalescing": "deny",
  "typescript/prefer-optional-chain": "deny",
  "typescript/prefer-promise-reject-errors": [
    "deny",
    [
      {
        "allowThrowingUnknown": true
      }
    ]
  ],
  "typescript/prefer-readonly": "deny",
  "typescript/prefer-reduce-type-parameter": "deny",
  "typescript/prefer-string-starts-ends-with": "deny",
  "typescript/promise-function-async": "deny",
  "typescript/require-array-sort-compare": "warn",
  "typescript/require-await": "allow",
  "typescript/restrict-template-expressions": [
    "deny",
    [
      {
        "allowBoolean": true,
        "allowNumber": true
      }
    ]
  ],
  "typescript/switch-exhaustiveness-check": [
    "deny",
    [
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ]
  ],
  "typescript/triple-slash-reference": "warn",
  "typescript/unbound-method": "warn",
  "typescript/unified-signatures": "deny",
  "vitest/consistent-test-it": [
    "deny",
    [
      {
        "fn": "it"
      }
    ]
  ],
  "vitest/expect-expect": "warn",
  "vitest/hoisted-apis-on-top": "warn",
  "vitest/no-alias-methods": "deny",
  "vitest/no-commented-out-tests": "deny",
  "vitest/no-conditional-expect": "deny",
  "vitest/no-conditional-in-test": "deny",
  "vitest/no-conditional-tests": "warn",
  "vitest/no-disabled-tests": "deny",
  "vitest/no-duplicate-hooks": "deny",
  "vitest/no-focused-tests": "deny",
  "vitest/no-interpolation-in-snapshots": "deny",
  "vitest/no-mocks-import": "deny",
  "vitest/no-restricted-matchers": [
    "deny",
    [
      {
        "resolves": "Use `expect(await promise)` instead.",
        "toBeFalsy": "Avoid `toBeFalsy`.",
        "toBeTruthy": "Avoid `toBeTruthy`.",
        "toMatchSnapshot": "Use `toMatchInlineSnapshot()` instead.",
        "toThrowErrorMatchingSnapshot": "Use `toThrowErrorMatchingInlineSnapshot()` instead."
      }
    ]
  ],
  "vitest/no-standalone-expect": "deny",
  "vitest/no-test-prefixes": "deny",
  "vitest/no-test-return-statement": "deny",
  "vitest/prefer-hooks-on-top": "deny",
  "vitest/prefer-lowercase-title": [
    "deny",
    [
      {
        "ignore": ["describe"]
      }
    ]
  ],
  "vitest/prefer-snapshot-hint": "warn",
  "vitest/prefer-spy-on": "deny",
  "vitest/prefer-strict-equal": "deny",
  "vitest/prefer-to-be": "deny",
  "vitest/prefer-to-contain": "deny",
  "vitest/prefer-to-have-length": "deny",
  "vitest/prefer-todo": "deny",
  "vitest/require-awaited-expect-poll": "warn",
  "vitest/require-local-test-context-for-concurrent-snapshots": "warn",
  "vitest/require-mock-type-parameters": "warn",
  "vitest/require-to-throw-message": "deny",
  "vitest/require-top-level-describe": "deny",
  "vitest/valid-describe-callback": "warn",
  "vitest/valid-expect": [
    "deny",
    [
      {
        "alwaysAwait": true
      }
    ]
  ],
  "vitest/valid-expect-in-promise": "warn",
  "vitest/valid-title": "warn",
  "vitest/warn-todo": "warn"
}
