{
  "name": "@metamask/oxlint-config-jest",
  "version": "15.0.0",
  "description": "Shareable MetaMask Oxlint config for Jest",
  "homepage": "https://github.com/MetaMask/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/oxlint-config/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/oxlint-config.git"
  },
  "files": [
    "src/",
    "!src/**/*.test.js",
    "!src/__test__/"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "changelog:update": "../../scripts/update-changelog.sh @metamask/oxlint-config-jest",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/oxlint-config-jest",
    "lint:changelog": "auto-changelog validate",
    "publish": "npm publish",
    "test": "oxlint ."
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^3.4.4",
    "@metamask/oxlint-config": "workspace:^",
    "oxlint": "^1.59.0",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@metamask/oxlint-config": "workspace:^",
    "eslint-plugin-jest": "^28.8.3",
    "oxlint": "^1.59.0"
  },
  "engines": {
    "node": "^18.18 || >=20"
  }
}
